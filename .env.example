# Copy to .env and fill in real values. Never commit the real .env file.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=esg_platform
MYSQL_USER=esg_app
MYSQL_PASSWORD=change_me_app
DATABASE_URL=mysql://esg_app:change_me_app@mysql:3306/esg_platform

# --- Backend ---
NODE_ENV=development
PORT=3000
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Storage ---
# STORAGE_DRIVER: local | s3
STORAGE_DRIVER=s3
STORAGE_S3_ENDPOINT=http://minio:9000
# Used only to SIGN download URLs — must be a host the downloader (a
# browser, outside the Docker network) can actually reach, unlike the
# internal `minio` hostname above. Change to your real domain once deployed
# behind a real reverse proxy/cloud endpoint.
STORAGE_S3_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=esg-platform
STORAGE_S3_ACCESS_KEY=esg_minio_admin
STORAGE_S3_SECRET_KEY=change_me_minio_secret
STORAGE_S3_FORCE_PATH_STYLE=true

# --- Simulator ---
SIMULATOR_BACKEND_URL=http://backend:3000
SIMULATOR_INTERVAL_MS=15000
SIMULATOR_ENABLED=true
# Must match the device rows prisma/seed-data/devices.ts creates — the
# seed hashes this same value into devices.api_key_hash for the 3 demo
# devices, so the simulator can authenticate against them out of the box.
SIMULATOR_DEVICE_API_KEY=change_me_simulator_key

# --- Frontends (build-time) ---
VITE_API_BASE_URL=http://localhost:8080/api
