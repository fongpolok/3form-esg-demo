# Used by the Prisma CLI when run directly on the host (outside Docker),
# e.g. `npm run prisma:generate` or `npm run prisma:migrate`. Copy to .env
# and adjust the port if you're not using the docker-compose mysql service's
# published port. Inside Docker, the backend container gets DATABASE_URL from
# the root .env / docker-compose.yml instead — this file is host-side only.
DATABASE_URL=mysql://esg_app:change_me_app@localhost:3306/esg_platform
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
